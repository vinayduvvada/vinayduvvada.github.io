// DOM Elements
const postsContainer = document.getElementById('postsContainer');
const tagsContainer = document.getElementById('tagsContainer');
const searchInput = document.getElementById('searchInput');
const searchBtn = document.getElementById('searchBtn');
const progressBar = document.getElementById('progressBar');

// Store posts data
let blogPosts = [];
let allTags = [];
let activeTag = 'all';
let searchQuery = '';

// Load posts data
async function loadPosts() {
    try {
        // In a real app, this would be an API endpoint that returns the list of posts
        const posts = [
            'getting-started-with-modern-javascript',
            'css-grid-layout'
        ];
        
        const loadedPosts = await Promise.all(
            posts.map(async (postId) => {
                try {
                    const response = await fetch(`posts/${postId}/metadata.json`);
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    const metadata = await response.json();
                    return {
                        ...metadata,
                        image: `posts/${postId}/${metadata.coverImage}`
                    };
                } catch (error) {
                    console.error(`Error loading post ${postId}:`, error);
                    return null;
                }
            })
        );
        
        blogPosts = loadedPosts.filter(post => post !== null);
        allTags = [...new Set(blogPosts.flatMap(post => post.tags))];
        return blogPosts;
    } catch (error) {
        console.error('Error loading posts:', error);
        return [];
    }
}

// Initialize the blog
async function initBlog() {
    const posts = await loadPosts();
    displayPosts(posts);
    createTagFilters();
    setupEventListeners();
}

// Display posts in the grid
function displayPosts(posts) {
    if (!postsContainer) {
        console.error('Posts container not found!');
        return;
    }

    postsContainer.innerHTML = '';

    if (posts.length === 0) {
        postsContainer.innerHTML = '<p class="no-results">No posts found matching your criteria.</p>';
        return;
    }

    posts.forEach(post => {
        const postElement = document.createElement('div');
        postElement.className = 'post-card';
        postElement.innerHTML = `
            <img src="${post.image}" alt="${post.title}" class="post-image">
            <div class="post-info">
                <h3 class="post-title">${post.title}</h3>
                <p class="post-excerpt">${post.excerpt}</p>
                <div class="post-meta">
                    <span>${post.date}</span>
                    <span>${post.readTime}</span>
                </div>
                <div class="post-tags">
                    ${post.tags.map(tag => `<span class="tag">${tag}</span>`).join('')}
                </div>
            </div>
        `;

        postElement.addEventListener('click', () => navigateToPost(post));
        postsContainer.appendChild(postElement);
    });
}

// Create tag filters
function createTagFilters() {
    if (!tagsContainer) return;

    const allTagsButton = document.createElement('span');
    allTagsButton.className = 'tag active';
    allTagsButton.textContent = 'All';
    allTagsButton.dataset.tag = 'all';
    allTagsButton.addEventListener('click', () => filterByTag('all'));
    tagsContainer.appendChild(allTagsButton);

    allTags.forEach(tag => {
        const tagElement = document.createElement('span');
        tagElement.className = 'tag';
        tagElement.textContent = tag;
        tagElement.dataset.tag = tag;
        tagElement.addEventListener('click', () => filterByTag(tag));
        tagsContainer.appendChild(tagElement);
    });
}

// Filter posts by tag
function filterByTag(tag) {
    activeTag = tag;

    document.querySelectorAll('.tag').forEach(el => {
        el.classList.toggle('active', el.dataset.tag === tag);
    });

    filterPosts();
}

// Filter posts based on search query and active tag
function filterPosts() {
    let filteredPosts = [...blogPosts];

    if (activeTag !== 'all') {
        filteredPosts = filteredPosts.filter(post =>
            post.tags.includes(activeTag)
        );
    }

    if (searchQuery) {
        const query = searchQuery.toLowerCase();
        filteredPosts = filteredPosts.filter(post =>
            post.title.toLowerCase().includes(query) ||
            post.excerpt.toLowerCase().includes(query) ||
            post.tags.some(tag => tag.includes(query))
        );
    }

    displayPosts(filteredPosts);
}

// Navigate to post page
function navigateToPost(post) {
    window.location.href = `post.html?id=${post.id}`;
}

// Setup event listeners
function setupEventListeners() {
    if (searchBtn && searchInput) {
        searchBtn.addEventListener('click', () => {
            searchQuery = searchInput.value.trim().toLowerCase();
            filterPosts();
        });

        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                searchQuery = searchInput.value.trim().toLowerCase();
                filterPosts();
            }
        });
    }

    if (progressBar) {
        window.addEventListener('scroll', updateProgressBar);
    }
}

// Update reading progress bar
function updateProgressBar() {
    if (!progressBar) return;
    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight - windowHeight;
    const scrolled = window.scrollY;
    const progress = (scrolled / documentHeight) * 100;
    progressBar.style.width = `${progress}%`;
}

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', () => {
    initBlog().catch(error => {
        console.error('Failed to initialize blog:', error);
        if (postsContainer) {
            postsContainer.innerHTML = '<div class="error">Failed to load blog posts. Please try again later.</div>';
        }
    });
});
